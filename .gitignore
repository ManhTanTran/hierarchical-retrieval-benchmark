# Data, models, caches, and experiment outputs must stay out of Git.
data/*
!data/.gitkeep
cache/*
!cache/.gitkeep
outputs/*
!outputs/.gitkeep
dapr_hhr_outputs/
dapr_hhr_cache/
dapr_hf_cache/

__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
.env
.env.*
!.env.example
.ipynb_checkpoints/
# Kaggle notebooks are maintained locally and uploaded directly to Kaggle.
*.ipynb
*.npy
*.npz
*.faiss
*.index
*.bin
*.pt
*.pth
